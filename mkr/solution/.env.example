# Copy to .env. Never commit real keys.
TELEGRAM_BOT_TOKEN=
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Images use Groq independently of the text model/provider.
VISION_MODEL=qwen/qwen3.8-27b
# News collection runs in the background independently of digest requests.
NEWS_POLL_MINUTES=1
# Optional shared file manager. Enable only after installing requirements-files.txt.
FILES_ENABLED=0
FILES_ALLOWED_USER_IDS=
# Generate with: python solution/file_store.py (or python file_store.py from solution).
FILES_PASSWORD_HASH=
# HTTPS domain; for an SSH tunnel/local preview: http://127.0.0.1:8080
FILES_PUBLIC_URL=http://127.0.0.1:8080
FILES_PORT=8080
# Limits in MB, not preallocated disk space. Restart after changing max file size.
FILES_STORAGE_LIMIT_MB=5120
FILES_MAX_FILE_MB=2048
# Voice transcription uses Groq even if text chats use Ollama.
STT_MODEL=whisper-large-v3-turbo
# Blank: detect language; use uk to explicitly select Ukrainian.
STT_LANGUAGE=
# Assumptions for estimated time savings, not measured personal speeds.
READING_WPM=200
PLAYBACK_SPEED=1
# Local alternative: LLM_PROVIDER=ollama, LLM_MODEL=qwen3.5:9b

# Files and folders in one folder upload (1..100000).
FILES_MAX_UPLOAD_ITEMS=10000

# Guest sends of website-uploaded files: bot must be admin in this private cache channel.
FILES_TELEGRAM_CACHE_CHAT_ID=

# Optional model for news only; blank inherits LLM_MODEL.
NEWS_MODEL=
